<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" stops cloud backup but, from Android 12, not a device-to-device transfer.
    The app holds signed-in browser cookies and a list of what was downloaded, and neither should
    follow the phone anywhere on its own.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
